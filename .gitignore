# Repository-local exclusions
# Evidence file types are intentionally NOT ignored.

# Operating-system artifacts
.DS_Store
Thumbs.db
Desktop.ini
$RECYCLE.BIN/

# Editor temporary files
~$*
*.swp
*.swo
*.tmp
*.temp

# Local IDE state
.Rproj.user/
.vscode/
.idea/

# Local credentials and machine-specific environment files
.Renviron
.env
.env.*
*.key
*.pem
*.p12
*.pfx
credentials.json
token.json
secrets.json

# Explicitly local working areas; canonical repository folders are not ignored
/local_data/
/restricted_data/
/scratch_local/
/temporary_clone_test/

# Important preservation rule:
# Do not add broad exclusions for .RData, .Rhistory, .log, .zip, .pbix,
# .docx, .xlsx, .pptx, .pdf, or evidence folders. Those file types may be
# intentional doctoral evidence.
