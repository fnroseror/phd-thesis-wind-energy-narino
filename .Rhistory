rolling_arima_predict_v2 <- function(
grid,
pairs,
base_fit,
transformation = c("raw", "log1p"),
max_origins = NULL
) {
transformation <- match.arg(transformation)
pairs <- copy(pairs)
setorder(pairs, origin_time)
if (!is.null(max_origins)) {
pairs <- pairs[
seq_len(min(max_origins, .N))
]
}
h <- unique(pairs$horizon_h)
stopifnot(length(h) == 1L)
OUT <- vector(
"list",
nrow(pairs)
)
for (i in seq_len(nrow(pairs))) {
HISTORY <- grid[
Hora <= pairs$origin_time[i]
]
y <- HISTORY$WPD
if (transformation == "log1p") {
y <- ifelse(
is.na(y),
NA_real_,
log1p(y)
)
}
y <- ts(
as.numeric(y),
frequency = 1
)
updated_fit <- tryCatch(
forecast::Arima(
y,
model = base_fit
),
error = function(e) NULL
)
if (is.null(updated_fit)) {
OUT[[i]] <- data.table(
prediction = NA_real_,
prediction_median = NA_real_,
model_scale_mean = NA_real_,
model_scale_se = NA_real_,
negative_raw = NA,
forecast_ok = FALSE
)
next
}
pr <- tryCatch(
stats::predict(
updated_fit,
n.ahead = h
),
error = function(e) NULL
)
if (is.null(pr)) {
OUT[[i]] <- data.table(
prediction = NA_real_,
prediction_median = NA_real_,
model_scale_mean = NA_real_,
model_scale_se = NA_real_,
negative_raw = NA,
forecast_ok = FALSE
)
next
}
mu <- as.numeric(
pr$pred[h]
)
se <- as.numeric(
pr$se[h]
)
if (transformation == "raw") {
prediction <- max(0, mu)
prediction_median <- prediction
negative_raw <-
is.finite(mu) && mu < 0
} else {
prediction_median <- max(
0,
expm1(mu)
)
prediction <- max(
0,
exp(mu + 0.5 * se^2) - 1
)
negative_raw <- FALSE
}
OUT[[i]] <- data.table(
prediction = prediction,
prediction_median = prediction_median,
model_scale_mean = mu,
model_scale_se = se,
negative_raw = negative_raw,
forecast_ok =
is.finite(prediction)
)
}
cbind(
pairs,
rbindlist(OUT, fill = TRUE)
)
}
TIME_LOG_V4 <- system.time({
PILOT_LOG_V4 <- rolling_arima_predict_v2(
grid = GRID_PILOT,
pairs = VALID_PAIRS,
base_fit = fit_log_fold_v2,
transformation = "log1p",
max_origins = 100
)
})
print(TIME_LOG_V4)
PILOT_LOG_V4[
,
.(
N = .N,
Forecast_OK = sum(forecast_ok, na.rm = TRUE),
Prediction_finite = sum(is.finite(prediction)),
Median_finite = sum(is.finite(prediction_median)),
Mu_finite = sum(is.finite(model_scale_mean)),
SE_finite = sum(is.finite(model_scale_se))
)
]
print(
metric_summary(
PILOT_LOG_V4
)
)
