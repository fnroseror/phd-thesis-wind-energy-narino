# ============================================================
# PREDICCIÓN ARIMA ROBUSTA
# Manejo explícito de drift
# ============================================================
predict_arima_fixed <- function(fit, h) {
coef_names <- names(coef(fit))
has_drift <- "drift" %in% coef_names
# ----------------------------------------------------------
# Caso 1: modelo con drift
# ----------------------------------------------------------
if (has_drift) {
# Recuperamos el último valor del drift utilizado
# en la actualización del modelo.
if (
!is.null(fit$xreg) &&
"drift" %in% colnames(fit$xreg)
) {
drift_hist <- fit$xreg[, "drift"]
drift_hist <- drift_hist[
is.finite(drift_hist)
]
drift_last <- tail(
drift_hist,
1
)
} else {
# Fallback defensivo
drift_last <- length(fit$x)
}
NEW_XREG <- matrix(
drift_last + seq_len(h),
ncol = 1
)
colnames(NEW_XREG) <- "drift"
pr <- stats::predict(
fit,
n.ahead = h,
newxreg = NEW_XREG
)
} else {
# --------------------------------------------------------
# Caso 2: ARIMA sin drift
# --------------------------------------------------------
pr <- stats::predict(
fit,
n.ahead = h
)
}
list(
mean = as.numeric(pr$pred),
se = as.numeric(pr$se)
)
}
ONE <- VALID_PAIRS[1]
ONE_ORIGIN <- ONE$origin_time
HISTORY_ONE <- GRID_PILOT[
Hora <= ONE_ORIGIN
]
