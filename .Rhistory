model = fit_log_fold
)
# Dejamos explícitamente asociada la serie
UPDATED_LOG_ONE$x <- Y_LOG_ONE
PR_ONE <- predict_arima_fixed(
UPDATED_LOG_ONE,
H_PILOT
)
fit_arima_exact_v2 <- function(y) {
y <- ts(
as.numeric(y),
frequency = 1
)
fits <- list()
for (d in 0:1) {
fit <- tryCatch(
forecast::auto.arima(
y,
d = d,
seasonal = FALSE,
max.p = 3,
max.q = 3,
max.order = 5,
stepwise = FALSE,
approximation = FALSE,
ic = "aicc",
method = "ML",
allowmean = TRUE,
# IMPORTANTE:
# no drift -> no regresor determinista externo
allowdrift = FALSE
),
error = function(e) NULL
)
if (!is.null(fit)) {
fits[[paste0("d", d)]] <- fit
}
}
if (length(fits) == 0L) {
stop("No fue posible estimar ningún ARIMA.")
}
AICC <- sapply(
fits,
function(x) x$aicc
)
fits[[which.min(AICC)]]
}
fit_raw_fold_v2 <- fit_arima_exact_v2(
TRAIN_GRID$WPD
)
fit_log_fold_v2 <- fit_arima_exact_v2(
ifelse(
is.na(TRAIN_GRID$WPD),
NA_real_,
log1p(TRAIN_GRID$WPD)
)
)
cat("\n=== RAW v2 ===\n")
print(fit_raw_fold_v2)
print(forecast::arimaorder(fit_raw_fold_v2))
cat("\n=== LOG1P v2 ===\n")
print(fit_log_fold_v2)
print(forecast::arimaorder(fit_log_fold_v2))
cat("\nRAW xreg:\n")
print(fit_raw_fold_v2$xreg)
cat("\nLOG xreg:\n")
print(fit_log_fold_v2$xreg)
predict_arima_fixed_v2 <- function(
fit,
h
) {
if (!is.null(fit$xreg)) {
stop(
"El modelo contiene xreg. ",
"ARIMA benchmark v2 exige xreg = NULL."
)
}
pr <- stats::predict(
fit,
n.ahead = h
)
list(
mean =
as.numeric(pr$pred),
se =
as.numeric(pr$se)
)
}
